# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Password for signing in to your personal dashboard
ADMIN_PASSWORD="change-this-password"

# 32+ character secret used to encrypt OAuth tokens in NeonDB and sign login cookies
APP_SECRET="generate-a-long-random-hex-secret-here"

# Optional secret for external Cron triggers (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Google Cloud Code OAuth Client for Antigravity accounts
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
